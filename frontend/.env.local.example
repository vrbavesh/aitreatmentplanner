# frontend/.env.local.example — LLD v2 §10. Copy to frontend/.env.local and fill in real values.
# NEVER commit frontend/.env.local. All values below are empty placeholders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # safe to expose in browser; RLS-scoped
NEXT_PUBLIC_BACKEND_URL=                # e.g. http://127.0.0.1:8000 for local dev