# backend/.env.example — LLD v2 §10. Copy to backend/.env and fill in real values.
# NEVER commit backend/.env. All values below are empty placeholders.
SUPABASE_URL=
SUPABASE_SECRET_KEY=              # server-only; bypasses RLS — never expose to frontend
GEMINI_API_KEY=                   # single key, reused for document extraction (OCR+fields)
                                 # and treatment explanation text — no separate OCR provider
LLM_MODEL_NAME=gemini-2.5-flash   # Gemini API (Google AI Studio, free tier)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_UPLOAD_BYTES=10485760